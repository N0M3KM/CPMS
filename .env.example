# Copy to .env and fill in local-only values. Never commit .env.
# Dev database container (compose.dev.yml)
CPMS_DB_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://cpms:change-me-local-only@127.0.0.1:5433/cpms_dev
# Separate test database. Tests refuse any database whose name does not end in _test.
TEST_DATABASE_URL=postgresql://cpms:change-me-local-only@127.0.0.1:5433/cpms_test
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-at-least-16-chars
SESSION_TTL_HOURS=8
ALLOWED_ORIGIN=http://localhost:5173
# Seed passwords for synthetic accounts
SEED_STUDENT_PASSWORD=change-me-student
SEED_SUPERVISOR_PASSWORD=change-me-supervisor
