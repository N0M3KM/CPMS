# Copy to .env and fill in local-only values. Never commit .env.
# Every environment variable the app reads is listed here; see docs/labs/lab-05/deployment.md for
# the purpose of each one and where its value comes from in each environment.

# --- Local PostgreSQL container (compose.dev.yml and docker-compose.yml) ---------------------------
# Use URL-safe characters (letters and digits, for example `openssl rand -hex 12`) because the
# password is also written into the DATABASE_URL values below.
CPMS_DB_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://cpms:change-me-local-only@127.0.0.1:5433/cpms_dev
# Separate test database. Tests refuse any database whose name does not end in _test.
TEST_DATABASE_URL=postgresql://cpms:change-me-local-only@127.0.0.1:5433/cpms_test

# --- Application ------------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# At least 16 characters. Required when NODE_ENV=production.
SESSION_SECRET=change-me-at-least-16-chars
SESSION_TTL_HOURS=8
# The origin the browser uses. State-changing requests from any other origin are refused.
# Required in production: the public https URL (or http://localhost for a local container run).
ALLOWED_ORIGIN=http://localhost:5173
# Trusted proxy hops in front of the app: 1 on Cloud Run, 0 on a laptop. Needed so the rate limits
# see the real client address.
TRUST_PROXY=0
# Optional: directory of the built client to serve. In production it defaults to ../client/dist.
# CLIENT_DIST=
# Set by the image build (docker build --build-arg APP_COMMIT=<sha>); shown by GET /api/version.
# APP_COMMIT=

# --- Seed passwords for the synthetic demo accounts -------------------------------------------------
SEED_STUDENT_PASSWORD=change-me-student
SEED_SUPERVISOR_PASSWORD=change-me-supervisor

# --- Optional smoke test (deploy/smoke_test.py): a seeded STUDENT account, set both or neither -----
# SMOKE_EMAIL=student.a1@example.test
# SMOKE_PASSWORD=
