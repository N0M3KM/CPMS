{
  "name": "cpms",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm test -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck -w server"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
